    "        d['TASA_MISSING_ESTADO_AGENCIA'] = d['TASA_MISSING_ESTADO_AGENCIA'].fillna(mg)\n",
    "\n",
    "    m = CatBoostClassifier(iterations=500, depth=5, learning_rate=0.03, l2_leaf_reg=5,\n",
